{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditLog",
  "type": "object",
  "required": [
    "event_id",
    "wallet",
    "threat_type",
    "threat_level",
    "recommended_action",
    "execution_result",
    "final_state",
    "execution_layer",
    "intent_compiler",
    "proof_type"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "wallet": { "type": "string" },
    "threat_type": { "type": "string" },
    "threat_level": { "type": "string" },
    "recommended_action": { "type": "string" },
    "execution_result": { "type": "string" },
    "final_state": { "type": "string" },
    "execution_layer": { "type": "string" },
    "intent_compiler": { "type": "string" },
    "proof_type": { "type": "string" }
  }
}
